{
  "name": "clsu/iris",
  "type": "project",
  "description": "CLSU Performance Observatory - IRIS",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "phpoffice/phpword": "^1.2",
    "phpoffice/phpspreadsheet": "^1.29"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pail": "^1.2",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" }
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"],
    "post-update-cmd": ["@php artisan vendor:publish --tag=laravel-assets --ansi --force"],
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
    "post-create-project-cmd": ["@php artisan key:generate --ansi", "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"", "@php artisan migrate --graceful --ansi"]
  },
  "extra": { "laravel": { "dont-discover": [] } },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true }
}
